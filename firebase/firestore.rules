rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function admin() {
      return verified() && request.auth.token.email == 'omotesandodc@gmail.com';
    }
    function member() {
      return admin() || (verified()
        && request.auth.token.email in get(/databases/$(database)/documents/settings/clinic).data.emails);
    }
    match /settings/clinic {
      allow read: if member();
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['staff','emails','patterns'])
        && request.resource.data.staff is list && request.resource.data.staff.size() == 6
        && request.resource.data.emails is list && request.resource.data.emails.size() == 6
        && request.resource.data.patterns is map;
    }
    function staffSelf(uid) {
      return verified() && request.auth.uid == uid
        && request.auth.token.email in get(/databases/$(database)/documents/settings/clinic).data.emails;
    }
    match /staffProfiles/{uid} {
      allow read: if admin() || staffSelf(uid);
      allow create, update: if staffSelf(uid)
        && request.resource.data.keys().hasOnly(['email','name','slot'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.slot is int
        && request.resource.data.slot >= 0 && request.resource.data.slot < 6
        && get(/databases/$(database)/documents/settings/clinic).data.emails[request.resource.data.slot] == request.auth.token.email
        && get(/databases/$(database)/documents/settings/clinic).data.staff[request.resource.data.slot] == request.resource.data.name;
    }
    function validStart(data) {
      return data.keys().hasOnly(['day','clockIn','clockOut'])
        && data.day is int
        && data.day == int((request.time.toMillis() + 32400000) / 86400000)
        && data.clockIn == request.time && data.clockOut == null;
    }
    function validEnd() {
      return resource.data.clockOut == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clockOut'])
        && request.resource.data.clockOut == request.time
        && request.time >= resource.data.clockIn;
    }
    function validCorrection(uid) {
      let data = request.resource.data;
      let log = getAfter(/databases/$(database)/documents/attendance/$(uid)/corrections/$(data.correctionId)).data;
      return admin()
        && data.keys().hasOnly(['day','clockIn','clockOut','correctionId'])
        && data.day is int && data.clockIn is timestamp
        && data.day == int((data.clockIn.toMillis() + 32400000) / 86400000)
        && data.clockIn <= request.time
        && (data.clockOut == null || (data.clockOut is timestamp && data.clockOut >= data.clockIn && data.clockOut <= request.time))
        && log.after == data && log.updatedAt == request.time
        && !exists(/databases/$(database)/documents/attendance/$(uid)/corrections/$(data.correctionId));
    }
    function approvedRequest(uid, log) {
      let application = getAfter(/databases/$(database)/documents/correctionRequests/$(log.requestId)).data;
      return application.uid == uid && application.status == 'approved'
        && application.reviewedBy == request.auth.uid && application.reviewedAt == request.time
        && application.correctionId == log.after.correctionId
        && application.day == log.day && application.before == log.before
        && application.reason == log.reason
        && application.proposed.clockIn == log.after.clockIn && application.proposed.clockOut == log.after.clockOut;
    }
    match /correctionRequests/{id} {
      allow read: if admin() || staffSelf(resource.data.uid);
      allow create: if staffSelf(request.resource.data.uid)
        && request.resource.data.keys().hasOnly(['uid','day','before','proposed','reason','status','createdBy','createdAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time && request.resource.data.status == 'pending'
        && request.resource.data.reason is string && request.resource.data.reason.size() > 0 && request.resource.data.reason.size() <= 200
        && request.resource.data.day is int
        && request.resource.data.proposed.keys().hasOnly(['day','clockIn','clockOut'])
        && request.resource.data.proposed.day == request.resource.data.day
        && request.resource.data.proposed.clockIn is timestamp
        && request.resource.data.proposed.clockIn <= request.time
        && request.resource.data.day == int((request.resource.data.proposed.clockIn.toMillis() + 32400000) / 86400000)
        && (request.resource.data.proposed.clockOut == null || (request.resource.data.proposed.clockOut is timestamp
          && request.resource.data.proposed.clockOut >= request.resource.data.proposed.clockIn && request.resource.data.proposed.clockOut <= request.time))
        && (exists(/databases/$(database)/documents/attendance/$(request.resource.data.uid)/days/$(string(request.resource.data.day)))
          ? request.resource.data.before == get(/databases/$(database)/documents/attendance/$(request.resource.data.uid)/days/$(string(request.resource.data.day))).data
          : request.resource.data.before == null);
      allow update: if admin() && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedBy','reviewedAt','correctionId'])
        && request.resource.data.reviewedBy == request.auth.uid && request.resource.data.reviewedAt == request.time
        && (request.resource.data.status == 'rejected' || (request.resource.data.status == 'approved'
          && getAfter(/databases/$(database)/documents/attendance/$(resource.data.uid)/corrections/$(request.resource.data.correctionId)).data.requestId == id
          && getAfter(/databases/$(database)/documents/attendance/$(resource.data.uid)/corrections/$(request.resource.data.correctionId)).data.updatedAt == request.time
          && !exists(/databases/$(database)/documents/attendance/$(resource.data.uid)/corrections/$(request.resource.data.correctionId))));
    }
    match /attendance/{uid} {
      allow read: if admin() || staffSelf(uid);
      allow create: if staffSelf(uid) && validStart(request.resource.data)
        && getAfter(/databases/$(database)/documents/attendance/$(uid)/days/$(string(request.resource.data.day))).data == request.resource.data;
      allow update: if staffSelf(uid)
        && (validEnd() || (resource.data.clockOut != null
          && request.resource.data.day > resource.data.day && validStart(request.resource.data)))
        && getAfter(/databases/$(database)/documents/attendance/$(uid)/days/$(string(request.resource.data.day))).data == request.resource.data;
      allow create: if validCorrection(uid)
        && getAfter(/databases/$(database)/documents/attendance/$(uid)/days/$(string(request.resource.data.day))).data == request.resource.data;
      allow update: if validCorrection(uid)
        && request.resource.data.day >= resource.data.day
        && (request.resource.data.day == resource.data.day || resource.data.clockOut != null)
        && getAfter(/databases/$(database)/documents/attendance/$(uid)/days/$(string(request.resource.data.day))).data == request.resource.data;
      match /corrections/{id} {
        allow read: if admin() || staffSelf(uid);
        allow create: if admin()
          && request.resource.data.keys().hasOnly(['day','before','after','reason','updatedBy','updatedAt','requestId'])
          && (!('requestId' in request.resource.data) || approvedRequest(uid,request.resource.data))
          && request.resource.data.day is int
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time
          && request.resource.data.reason is string
          && request.resource.data.reason.size() > 0 && request.resource.data.reason.size() <= 200
          && request.resource.data.after.correctionId == id
          && request.resource.data.after.day == request.resource.data.day
          && getAfter(/databases/$(database)/documents/attendance/$(uid)/days/$(string(request.resource.data.day))).data == request.resource.data.after
          && (exists(/databases/$(database)/documents/attendance/$(uid)/days/$(string(request.resource.data.day)))
            ? request.resource.data.before == get(/databases/$(database)/documents/attendance/$(uid)/days/$(string(request.resource.data.day))).data
            : request.resource.data.before == null);
      }
      match /reviews/{day} {
        allow read: if admin() || staffSelf(uid);
        allow create, update: if admin()
          && request.resource.data.keys().hasOnly(['day','breakMinutes','source','updatedAt','updatedBy'])
          && request.resource.data.day is int
          && day == string(request.resource.data.day)
          && (!('source' in request.resource.data) || request.resource.data.source in ['automatic','manual'])
          && request.resource.data.breakMinutes is int
          && request.resource.data.breakMinutes >= 0
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time
          && get(/databases/$(database)/documents/attendance/$(uid)/days/$(day)).data.clockOut is timestamp
          && request.resource.data.breakMinutes * 60000 <=
            get(/databases/$(database)/documents/attendance/$(uid)/days/$(day)).data.clockOut.toMillis()
            - get(/databases/$(database)/documents/attendance/$(uid)/days/$(day)).data.clockIn.toMillis();
      }
      match /days/{day} {
        allow create, update: if validCorrection(uid)
          && day == string(request.resource.data.day)
          && (getAfter(/databases/$(database)/documents/attendance/$(uid)).data.day == request.resource.data.day
            ? getAfter(/databases/$(database)/documents/attendance/$(uid)).data == request.resource.data
            : getAfter(/databases/$(database)/documents/attendance/$(uid)).data.day > request.resource.data.day && request.resource.data.clockOut != null);
        allow read: if admin() || staffSelf(uid);
        allow create: if staffSelf(uid) && validStart(request.resource.data)
          && day == string(request.resource.data.day)
          && getAfter(/databases/$(database)/documents/attendance/$(uid)).data == request.resource.data;
        allow update: if staffSelf(uid) && validEnd()
          && getAfter(/databases/$(database)/documents/attendance/$(uid)).data == request.resource.data;
      }
    }
    match /leaveBalances/{uid} {
      allow read: if admin() || staffSelf(uid);
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['units','updatedBy','updatedAt'])
        && request.resource.data.units is int && request.resource.data.units >= 0
        && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
      match /history/{id} {
        allow read: if admin() || staffSelf(uid);
        allow create: if admin()
          && request.resource.data.keys().hasOnly(['before','after','reason','updatedBy','updatedAt'])
          && (request.resource.data.before == null || request.resource.data.before is int)
          && request.resource.data.after is int && request.resource.data.after >= 0
          && request.resource.data.reason is string && request.resource.data.reason.size() > 0 && request.resource.data.reason.size() <= 200
          && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
      }
    }
    match /leaveDays/{id} {
      allow read: if member();
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['uid','date','slot','am','pm'])
        && id == request.resource.data.uid + '_' + request.resource.data.date
        && request.resource.data.slot is int && request.resource.data.slot >= 0 && request.resource.data.slot < 6
        && request.resource.data.am is string && request.resource.data.pm is string;
    }
    function leaveApplied(id, data, cancelling) {
      let units = data.part == 'full' ? 2 : 1;
      let before = get(/databases/$(database)/documents/leaveBalances/$(data.uid)).data.units;
      let after = getAfter(/databases/$(database)/documents/leaveBalances/$(data.uid)).data.units;
      let calendar = getAfter(/databases/$(database)/documents/leaveDays/$(data.uid + '_' + data.date)).data;
      let expected = cancelling ? '' : id;
      return after == before + (cancelling ? units : -units)
        && (data.part == 'pm' || calendar.am == expected)
        && (data.part == 'am' || calendar.pm == expected);
    }
    match /leaveRequestLocks/{uid}/days/{date} {
      function validLock() {
        let id = request.resource.data.requestId;
        let linked = getAfter(/databases/$(database)/documents/leaveRequests/$(id)).data;
        return request.resource.data.keys().hasOnly(['requestId'])
          && id is string
          && !exists(/databases/$(database)/documents/leaveRequests/$(id))
          && linked.uid == uid && linked.date == date && linked.status == 'pending';
      }
      allow read: if admin() || staffSelf(uid);
      allow create: if staffSelf(uid) && validLock();
      allow update: if staffSelf(uid) && validLock()
        && get(/databases/$(database)/documents/leaveRequests/$(resource.data.requestId)).data.status in ['rejected','cancelled'];
    }
    match /leaveRequests/{id} {
      allow read: if admin() || staffSelf(resource.data.uid);
      allow create: if staffSelf(request.resource.data.uid)
        && request.resource.data.keys().hasOnly(['uid','date','part','note','status','createdAt','createdBy'])
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.part == 'full'
        && request.resource.data.note is string && request.resource.data.note.size() <= 200
        && request.resource.data.status == 'pending'
        && getAfter(/databases/$(database)/documents/leaveRequestLocks/$(request.resource.data.uid)/days/$(request.resource.data.date)).data.requestId == id
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
      allow update: if admin() && (
        (resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedBy','reviewedAt'])
          && request.resource.data.reviewedBy == request.auth.uid && request.resource.data.reviewedAt == request.time
          && (request.resource.data.status == 'rejected' || (request.resource.data.status == 'approved' && resource.data.part == 'full' && leaveApplied(id,resource.data,false))))
        || (resource.data.status == 'approved' && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','cancelledBy','cancelledAt'])
          && request.resource.data.cancelledBy == request.auth.uid && request.resource.data.cancelledAt == request.time
          && leaveApplied(id,resource.data,true)));
    }
    match /shifts/{shiftId} {
      allow read: if member();
      allow create, update: if admin()
        && shiftId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-5]$')
        && request.resource.data.keys().hasOnly(['type','phone','updatedAt','updatedBy'])
        && request.resource.data.type in ['normal','early','late','off','leave','unset']
        && request.resource.data.phone is bool
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }
  }
}
